rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    // 3. PRODUCTS COLLECTION
    match /products/{productId} {
      // Anyone can read products to see the shop
      allow read: if true;
      
      // Only signed-in users (admins) can write
      // For now, allowing any signed-in user since we are in setup phase
      // In production, you should restrict this to specific admin UIDs
      allow write: if isSignedIn();
    }
  }
}
